{
  "name": "discord-ticket-bot",
  "version": "1.0.0",
  "description": "Professional Discord ticket bot built with discord.js and TypeScript.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "pm2-runtime start ecosystem.config.js",
    "deploy": "tsx src/deploy-commands.ts"
  },
  "keywords": [
    "discord",
    "bot",
    "ticket",
    "support"
  ],
  "author": "GitHub Copilot",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "optionalDependencies": {
    "pm2": "^5.4.3"
  }
}
